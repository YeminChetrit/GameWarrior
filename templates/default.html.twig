{% extends 'base.html.twig' %}

{% block title %}Accueil - Game Warrior{% endblock %}

{% block body %}

    <!-- Latest news -->
    <div class="latest-news-section">
        <div class="ln-title">Latest News</div>

        <div class="news-ticker">
            <div class="news-ticker-contant">
                {% for news in latestNews|default([]) %}
                    <div class="nt-item">
                        <span class="{{ news.category }}">{{ news.category }}</span>
                        {{ news.title }}
                    </div>
                {% endfor %}
            </div>
        </div>
    </div>

    <!-- Hero -->
    <section class="hero-section">
        <div class="hero-slider owl-carousel">

            <div class="hs-item set-bg" style="background-color: #666; background-blend-mode: multiply;" data-setbg="{{ asset('img/slider-1.jpg') }}">
                <div class="hs-text">
                    <div class="container">
                        <h2>The Best <span>Games</span> Out There</h2>
                        <p>
                            Lorem ipsum dolor sit amet, consectetur adipiscing elit.
                            Donec malesuada lorem maximus mauris scelerisque,
                            at rutrum nulla dictum.
                        </p>
                        <a href="#" class="site-btn">Read More</a>
                    </div>
                </div>
            </div>

            <div class="hs-item set-bg" style="background-color: #666; background-blend-mode: multiply;" data-setbg="{{ asset('img/slider-2.jpg') }}">
                <div class="hs-text">
                    <div class="container">
                        <h2>The Best <span>Games</span> Out There</h2>
                        <p>
                            Lorem ipsum dolor sit amet, consectetur adipiscing elit.
                            Donec malesuada lorem maximus mauris scelerisque,
                            at rutrum nulla dictum.
                        </p>
                        <a href="#" class="site-btn">Read More</a>
                    </div>
                </div>
            </div>

        </div>
    </section>

    <!-- Feature -->
    <section class="feature-section spad">
        <div class="container">
            <div class="row">
                {% for feature in features|default([]) %}
                    <div class="col-lg-3 col-md-6 p-0">
                        <div class="feature-item set-bg" data-setbg="{{ asset(feature.image) }}">

    <a href="{{ path('app_blog', {slug: feature.slug}) }}" class="card-link" aria-label="{{ feature.title }}"></a>

    <span class="cata new">{{ feature.genre }}</span>

    <div class="fi-content text-white">
        <h5>{{ feature.title }}</h5>
        <p>{{ feature.description }}</p>
        <a href="#" class="fi-comment">{{ feature.comments }} Comments</a>
    </div>

</div>
                    </div>
                {% endfor %}
            </div>
        </div>
    </section>

        <!-- Recent Games -->
    <section class="recent-game-section spad set-bg" data-setbg="{{ asset('img/recent-game-bg.png') }}">
        <div class="container">

            <div class="section-title">
                <div class="cata new">new</div>
                <h2>Recent Games</h2>
            </div>

            <div class="row">
                {% for game in games|default([]) %}
                    <div class="col-lg-4 col-md-6">
                        <div class="recent-game-item">

                            <div class="rgi-thumb set-bg" data-setbg="{{ asset(game.image) }}">
                                <a href="{{ path('app_blog', {slug: game.slug}) }}" class="card-link" aria-label="{{ game.title }}"></a>
                                <div class="cata new">{{ game.genre }}</div>
                            </div>

                            <div class="rgi-content">
                                <h5><a href="{{ path('app_blog', {slug: game.slug}) }}" class="game-link">{{ game.title }}</a></h5>
                                <p>{{ game.description }}</p>
                                <a href="#" class="comment">{{ game.comments }} Comments</a>

                                <div class="rgi-extra">
                                    <div class="rgi-star"><img src="{{ asset('img/icons/star.png') }}" alt=""></div>
                                    <div class="rgi-heart"><img src="{{ asset('img/icons/heart.png') }}" alt=""></div>
                                </div>
                            </div>

                        </div>
                    </div>
                {% else %}
                    <p>Aucun jeu disponible pour le moment.</p>
                {% endfor %}
            </div>
        </div>
    </section>

{% endblock %}