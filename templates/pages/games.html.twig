{% extends 'base.html.twig' %}

{% block title %}Games - Game Warrior{% endblock %}

{% block body %}

    <!-- Latest news section -->
    <div class="latest-news-section">
        <div class="ln-title">Latest News</div>
        <div class="news-ticker">
            <div class="news-ticker-contant">
                {% for news in latestNews|default([]) %}
                    <div class="nt-item">
                        <span class="{{ news.category }}">{{ news.category }}</span>
                        {{ news.title }}
                    </div>
                {% endfor %}
            </div>
        </div>
    </div>
    <!-- Latest news section end -->

    <!-- Page info section -->
    <section class="page-info-section set-bg" style="background-color: #858585; background-blend-mode: multiply;" data-setbg="{{ asset('img/page-top-bg/3.jpg') }}">
        <div class="pi-content">
            <div class="container">
                <div class="row">
                    <div class="col-xl-5 col-lg-6 text-white">
                        <h2>Game reviews</h2>
                        <p>Lorem ipsum dolor sit amet, consectetur adipiscing elit. Donec malesuada lorem maximus mauris scelerisque, at rutrum nulla dictum.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <!-- Page info section -->

    <!-- Page section -->
    <section class="page-section review-page spad">
        <div class="container">

            <div class="row" id="games-grid">
                {% include 'pages/_games_grid.html.twig' %}
            </div>
            <div class="text-center pt-4">
                <button id="load-more" class="site-btn btn-sm" type="button">Load More</button>
            </div>
        </div>
    </section>
    <!-- Page section end -->

    <!-- Review section -->
    <section class="review-section review-dark spad set-bg" data-setbg="{{ asset('img/review-bg-2.jpg') }}">
        <div class="container">
            <div class="section-title text-white">
                <div class="cata new">new</div>
                <h2>Recent Reviews</h2>
            </div>
            <div class="row text-white">
                {% for game in recentGames|default([]) %}
                    <div class="col-lg-3 col-md-6">
                        <div class="review-item">
                            <div class="review-cover set-bg" data-setbg="{{ asset(game.image) }}">
                                <div class="score {{ game.scoreColor|default('yellow') }}">{{ game.score }}</div>
                            </div>
                            <div class="review-text">
                                <h5>{{ game.title }}</h5>
                                <p>{{ game.description }}</p>
                            </div>
                        </div>
                    </div>
                {% else %}
                    <p>Aucun avis récent pour le moment.</p>
                {% endfor %}
            </div>
        </div>
    </section>
    <!-- Review section end -->

  <script>
document.addEventListener('DOMContentLoaded', function () {
    var PER_PAGE = 6; // nombre de jeux affichés à chaque fois
    var items = document.querySelectorAll('#games-grid > div');
    var button = document.getElementById('load-more');
    var visible = PER_PAGE;

    function render() {
        items.forEach(function (item, i) {
            item.style.display = i < visible ? '' : 'none';
        });
        // plus rien à afficher : on cache le bouton
        if (visible >= items.length) {
            button.style.display = 'none';
        }
    }

    button.addEventListener('click', function () {
        visible += PER_PAGE;
        render();
    });

    render();
});
</script>

{% endblock %}